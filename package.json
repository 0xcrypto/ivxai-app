{
  "name": "ivxai-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ivx/ai Chat for desktop and mobile, plus the standalone CORS bridge.",
  "license": "GPL-3.0-or-later",
  "author": "0xcrypto (https://eval.blog)",
  "repository": { "type": "git", "url": "git+https://github.com/ivxlabs/ivxai-app.git" },
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:init": "tauri android init && node scripts/android-overlay.mjs",
    "android:overlay": "node scripts/android-overlay.mjs",
    "android": "node scripts/android-overlay.mjs && tauri android dev",
    "ios": "tauri ios dev",
    "web:build": "npm --prefix web run build",
    "bridge": "cargo run --release -p ivx-bridge --",
    "bridge:build": "cargo build --release -p ivx-bridge",
    "test": "cargo test --workspace",
    "bump": "node scripts/version.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
